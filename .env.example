# =============================================================
# AIP Platform – Environment Variables Example
# Copy to .env (backend) or .env.local (frontend) and fill in values.
# NEVER commit real secrets to Git.
# Generate SECRET_KEY with: openssl rand -hex 32
# =============================================================

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://user:CHANGE_ME@localhost:5432/aip
POSTGRES_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD

# ── JWT Authentication ────────────────────────────────────────
SECRET_KEY=CHANGE_ME_RUN_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── CORS ──────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,https://your-production-domain.com

# ── Supabase ──────────────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=CHANGE_ME_ANON_KEY
SUPABASE_SERVICE_KEY=CHANGE_ME_SERVICE_ROLE_KEY
SUPABASE_JWT_SECRET=CHANGE_ME_JWT_SECRET
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=CHANGE_ME_ANON_KEY

# ── Anthropic Claude API ──────────────────────────────────────
ANTHROPIC_API_KEY=CHANGE_ME_ANTHROPIC_API_KEY

# ── Airtable ──────────────────────────────────────────────────
AIRTABLE_API_KEY=CHANGE_ME_PERSONAL_ACCESS_TOKEN
AIRTABLE_BASE_ID=CHANGE_ME_BASE_ID
AIRTABLE_PROJECTS_TABLE=CHANGE_ME_TABLE_ID
AIRTABLE_CACHE_TTL=300

# ── Azure Storage ─────────────────────────────────────────────
AZURE_STORAGE_CONNECTION_STRING=CHANGE_ME_CONNECTION_STRING
AZURE_STORAGE_CONTAINER=aip-documents

# ── App Config ────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NODE_ENV=development
ENVIRONMENT=development
PORT=8000
GUNICORN_WORKERS=2
