# =============================================================
# AIP Platform – Environment Variables
# Copy to .env (backend) and .env.local (frontend) and fill in values.
# NEVER commit real secrets to Git.
# =============================================================

# ── Database ──────────────────────────────────────────────────
# SQLite for local dev, PostgreSQL for production
DATABASE_URL=sqlite:///./aip.db
# DATABASE_URL=postgresql://user:password@host:5432/aip

# ── JWT Authentication ────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,https://www.app.africa-infra.com,https://www.africa-infra.com,https://aip-plum.vercel.app

# ── Supabase ──────────────────────────────────────────────────
SUPABASE_URL=https://evpbetmgmhwhhgwvnfb.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# ── Anthropic Claude API (AI Intelligence Engine) ────────────
# Required for PETFEL augmentation, EIN generation, country risk analysis
ANTHROPIC_API_KEY=your-anthropic-api-key

# ── Airtable (AIP Project Database) ──────────────────────────
# Create a Personal Access Token at: https://airtable.com/create/tokens
# Required scopes: data.records:read, schema.bases:read
AIRTABLE_API_KEY=your-airtable-personal-access-token
AIRTABLE_BASE_ID=appBWrnDeccJv9abz
AIRTABLE_PROJECTS_TABLE=tbltvszfwie3LzanF
# How long to cache Airtable responses (seconds). Default: 300 (5 min)
AIRTABLE_CACHE_TTL=300

# ── Azure Storage (file uploads in data rooms) ────────────────
AZURE_STORAGE_CONNECTION_STRING=your-azure-storage-connection-string
AZURE_STORAGE_CONTAINER=aip-documents

# ── Server ────────────────────────────────────────────────────
PORT=8000
# Number of Gunicorn workers (default: 4 for 2-core containers)
GUNICORN_WORKERS=4
