# =============================================================
# AIP Platform – Environment Variables Example
# Copy to .env.local (frontend) and fill in values.
# NEVER commit real secrets to Git.
# =============================================================

# ── Database ──────────────────────────────────────────────────
# Connection pool settings (recommended for production):
# ?connection_limit=20     → Max 20 simultaneous DB connections per instance
# &pool_timeout=30         → Wait 30s for available connection before timing out
# &connect_timeout=10      → 10s to establish new connection
# &statement_timeout=30000 → Cancel queries running longer than 30 seconds
DATABASE_URL=postgresql://user:CHANGE_ME@aip-db.postgres.database.azure.com:5432/aip_frontend?sslmode=require&connection_limit=20&pool_timeout=30&connect_timeout=10

# ── NextAuth ──────────────────────────────────────────────────
# Generate NEXTAUTH_SECRET with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3005
NEXTAUTH_SECRET=CHANGE_ME_RUN_openssl_rand_base64_32

# ── Public App URL ────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3005

# ── Resend Email Service ──────────────────────────────────────
RESEND_API_KEY=CHANGE_ME_RESEND_API_KEY
RESEND_FROM_EMAIL=AIP Platform <noreply@africa-infra.com>

# ── Azure AD (Entra ID) ───────────────────────────────────────
AZURE_AD_CLIENT_ID=CHANGE_ME_APP_CLIENT_ID
AZURE_AD_CLIENT_SECRET=CHANGE_ME_APP_CLIENT_SECRET
AZURE_AD_TENANT_ID=CHANGE_ME_TENANT_ID

# ── Anthropic Claude API ──────────────────────────────────────
ANTHROPIC_API_KEY=CHANGE_ME_ANTHROPIC_API_KEY

# ── Airtable ──────────────────────────────────────────────────
AIRTABLE_API_KEY=CHANGE_ME_PERSONAL_ACCESS_TOKEN
AIRTABLE_BASE_ID=CHANGE_ME_BASE_ID
AIRTABLE_PROJECTS_TABLE=CHANGE_ME_TABLE_ID
AIRTABLE_CACHE_TTL=300

# ── Azure Storage ─────────────────────────────────────────────
AZURE_STORAGE_CONNECTION_STRING=CHANGE_ME_CONNECTION_STRING
AZURE_STORAGE_CONTAINER=aip-documents

# ── API URL ───────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Cron Jobs ────────────────────────────────────────────────
# Secret for authenticating cron job requests
# Generate with: openssl rand -base64 32
CRON_SECRET=CHANGE_ME_CRON_SECRET

# ── Sentry Error Monitoring ───────────────────────────────────
# Leave blank to disable Sentry (safe for local dev)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=CHANGE_ME_SENTRY_AUTH_TOKEN
NEXT_PUBLIC_ENVIRONMENT=development
APP_VERSION=aip@1.0.0
NEXT_PUBLIC_APP_VERSION=aip@1.0.0
