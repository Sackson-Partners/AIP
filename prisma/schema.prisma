generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  ADMIN
  ANALYST
  GOVERNMENT
  SPONSOR_DEVELOPER
  EPC_OPERATOR
  INSTITUTIONAL_INVESTOR
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum AuthProvider {
  AZURE_AD
  INTERNAL
}

enum ProjectStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  ACTIVE
  FUNDED
  CLOSED
  REJECTED
  PIPELINE
  ON_HOLD
}

enum ProjectSector {
  ENERGY
  TRANSPORT
  WATER
  DIGITAL
  HEALTHCARE
  EDUCATION
  AGRICULTURE
  HOUSING
  WASTE_MANAGEMENT
  OTHER
}

enum ProjectType {
  PPP
  IPP
  CONCESSION
  BOT
  BOO
  DBFOM
  SERVICE_CONTRACT
  OTHER
}

enum DealStage {
  CONCEPT
  PREFEASIBILITY
  FEASIBILITY
  STRUCTURING
  PROCUREMENT
  FINANCIAL_CLOSE
  CONSTRUCTION
  OPERATIONS
}

enum InvestorType {
  PE_FUND
  DFI
  SOVEREIGN_WEALTH
  FAMILY_OFFICE
  PENSION_FUND
  INFRASTRUCTURE_FUND
  BANK
  OTHER
}

enum DocumentType {
  FEASIBILITY_STUDY
  ENVIRONMENTAL_IMPACT
  FINANCIAL_MODEL
  LEGAL_AGREEMENT
  TECHNICAL_SPECS
  EIN_REPORT
  PETFEL_REPORT
  COMPLIANCE_REPORT
  OTHER
}

enum NotificationType {
  PROJECT_UPDATE
  DEAL_ALERT
  COMPLIANCE_REMINDER
  SYSTEM_ALERT
  INVESTOR_MATCH
  DOCUMENT_REQUEST
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  DELAYED
  CANCELLED
  BLOCKED
}

// ─── NextAuth required models ─────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  ext_expires_in    Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Core models ──────────────────────────────────────────────────────────────

model User {
  id                 String       @id @default(cuid())
  azureOid           String?      @unique
  email              String       @unique
  emailVerified      DateTime?
  name               String?
  firstName          String?
  lastName           String?
  image              String?
  phone              String?
  jobTitle           String?
  organization       String?
  country            String?
  timezone           String?
  role               UserRole     @default(INSTITUTIONAL_INVESTOR)
  status             UserStatus   @default(PENDING)
  authProvider       AuthProvider @default(AZURE_AD)
  passwordHash       String?
  mustChangePass     Boolean      @default(false)
  twoFactorEnabled   Boolean      @default(false)
  twoFactorSecret    String?
  lastLoginAt          DateTime?
  lastLoginIp          String?
  loginCount           Int          @default(0)
  failedLoginAttempts  Int          @default(0)
  lockedUntil          DateTime?
  emailNotifications Boolean      @default(true)
  dashboardLayout    String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  createdBy          String?

  accounts          Account[]
  sessions          Session[]
  internalProfile   InternalProfile?
  investorProfile   InvestorProfile?
  governmentProfile GovernmentProfile?
  sponsorProfile    SponsorProfile?
  ePCProfile        EPCProfile?
  ownedProjects     Project[]        @relation("ProjectOwner")
  reviewedProjects  Project[]        @relation("ProjectReviewer")
  documents         Document[]
  notifications     Notification[]
  activityLogs      ActivityLog[]
  icVotes           IcVote[]
  createdEvents     Event[]
}

model InternalProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  employeeId     String   @unique
  department     String?
  accessLevel    Int      @default(1)
  canApprove     Boolean  @default(false)
  canPublish     Boolean  @default(false)
  canManageUsers Boolean  @default(false)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InvestorProfile {
  id               String        @id @default(cuid())
  userId           String        @unique
  investorType     InvestorType?
  aum              Float?
  minTicket        Float?
  maxTicket        Float?
  preferredSectors String[]
  preferredRegions String[]
  preferredStages  String[]
  riskTolerance    String?
  targetIRR        Float?
  requiresESG      Boolean       @default(false)
  accredited       Boolean       @default(false)
  kycVerified      Boolean       @default(false)
  kycDocument      String?

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  watchlist ProjectWatchlist[]
}

model GovernmentProfile {
  id              String  @id @default(cuid())
  userId          String  @unique
  ministry        String?
  country         String?
  region          String?
  pppUnitName     String?
  regulatoryAuth  String?
  verified        Boolean @default(false)
  verificationDoc String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SponsorProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  companyName     String?
  registrationNo  String?
  yearsExperience Int?
  portfolioSize   Float?
  sectors         String[]
  regions         String[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EPCProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  companyName    String?
  capabilities   String[]
  sectors        String[]
  regions        String[]
  certifications String[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id                String         @id @default(cuid())
  code              String         @unique
  title             String
  description       String?        @db.Text
  country           String?
  region            String?
  corridor          String?
  sector            ProjectSector?
  projectType       ProjectType?
  dealStage         DealStage      @default(CONCEPT)
  status            ProjectStatus  @default(DRAFT)
  totalCost         Float?
  equityRequired    Float?
  debtRequired      Float?
  grantRequired     Float?
  currency          String         @default("USD")
  expectedClose     DateTime?
  constructionStart DateTime?
  operationsStart   DateTime?
  concessionPeriod  Int?
  petfelScore       Float?
  einScore          Float?
  riskRating        String?
  esgRating         String?
  ownerId           String
  reviewerId        String?
  publishedAt       DateTime?
  featuredUntil     DateTime?
  viewCount         Int            @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  owner          User               @relation("ProjectOwner", fields: [ownerId], references: [id])
  reviewer       User?              @relation("ProjectReviewer", fields: [reviewerId], references: [id])
  petfelAnalysis PETFELAnalysis?
  einReport      EINReport?
  documents      Document[]
  milestones     Milestone[]
  watchlist      ProjectWatchlist[]
  dealRooms      DealRoom[]
  icCommittees   IcCommittee[]
  verifications  Verification[]
  events         Event[]

  @@index([ownerId])
  @@index([reviewerId])
  @@index([status])
  @@index([sector])
}

// PETFEL = Political, Economic, Technical, Financial, Environmental, Legal
model PETFELAnalysis {
  id                 String   @id @default(cuid())
  projectId          String   @unique
  politicalScore     Float?
  economicScore      Float?
  technicalScore     Float?
  financialScore     Float?
  environmentalScore Float?
  legalScore         Float?
  overallScore       Float?
  rating             String?
  aiMemo             String?  @db.Text
  riskFactors        String?  @db.Text
  mitigants          String?  @db.Text
  recommendations    String?  @db.Text
  analyzedAt         DateTime @default(now())
  updatedAt          DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model EINReport {
  id               String    @id @default(cuid())
  projectId        String    @unique
  einNumber        String    @unique
  projectSummary   String?   @db.Text
  financialSummary String?   @db.Text
  riskSummary      String?   @db.Text
  investmentThesis String?   @db.Text
  creditRating     String?
  riskRating       String?
  esgScore         Float?
  comparables      String?   @db.Text
  marketAnalysis   String?   @db.Text
  publishedAt      DateTime?
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Milestone {
  id          String    @id @default(cuid())
  projectId   String
  title       String
  description String?
  dueDate     DateTime?
  completedAt DateTime?
  status      MilestoneStatus @default(PENDING)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model DealRoom {
  id              String    @id @default(cuid())
  projectId       String
  name            String
  description     String?
  status          String    @default("ACTIVE")  // ACTIVE | NEGOTIATING | CLOSED | ARCHIVED
  dealValue       Float?
  dealCurrency    String    @default("USD")
  targetCloseDate DateTime?
  isPublic        Boolean   @default(false)
  requireNda      Boolean   @default(true)
  isVideoEnabled  Boolean   @default(true)
  isChatEnabled   Boolean   @default(true)
  /// TODO: always bcrypt-hash before writing; never store plaintext — enforce in API route
  password        String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Marketplace fields
  dealType      String?   // EQUITY | DEBT | GRANT | PPP | MEZZANINE
  targetRaise   Float?
  minTicket     Float?
  eoiDeadline   DateTime?
  featuredUntil DateTime?
  viewCount     Int       @default(0)
  eoiCount      Int       @default(0)

  project   Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  documents Document[]
  members   DealRoomMember[]
  folders   DealRoomFolder[]
  eois      ExpressionOfInterest[]

  @@index([projectId])
}

model DealRoomMember {
  id          String    @id @default(cuid())
  dealRoomId  String
  userId      String?
  email       String
  ndaSigned   Boolean   @default(false)
  ndaSignedAt DateTime?
  invitedBy   String?
  invitedAt   DateTime  @default(now())
  accessLevel String    @default("VIEW")  // VIEW | UPLOAD | MANAGE

  dealRoom DealRoom @relation(fields: [dealRoomId], references: [id], onDelete: Cascade)

  @@unique([dealRoomId, email])
  @@index([dealRoomId])
  @@index([userId])
}

model DealRoomFolder {
  id         String   @id @default(cuid())
  dealRoomId String
  name       String
  parentId   String?
  createdAt  DateTime @default(now())

  dealRoom  DealRoom         @relation(fields: [dealRoomId], references: [id], onDelete: Cascade)
  documents Document[]

  @@index([dealRoomId])
}

model DocumentAccessLog {
  id         String   @id @default(cuid())
  documentId String
  userId     String?
  email      String?
  action     String   // VIEW | DOWNLOAD
  ipAddress  String?
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([userId])
}

model ProjectWatchlist {
  id            String  @id @default(cuid())
  investorId    String
  projectId     String
  alertsEnabled Boolean @default(true)

  investor InvestorProfile @relation(fields: [investorId], references: [id], onDelete: Cascade)
  project  Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([investorId, projectId])
}

model Document {
  id             String       @id @default(cuid())
  projectId      String?
  dealRoomId     String?
  folderId       String?
  uploaderId     String
  name           String
  type           DocumentType @default(OTHER)
  mimeType       String?
  size           Int?
  blobUrl        String?
  blobKey        String?
  isPublic       Boolean      @default(false)
  isConfidential Boolean      @default(false)
  version        Int          @default(1)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  project    Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  dealRoom   DealRoom?          @relation(fields: [dealRoomId], references: [id], onDelete: SetNull)
  folder     DealRoomFolder?    @relation(fields: [folderId], references: [id], onDelete: SetNull)
  uploader   User               @relation(fields: [uploaderId], references: [id], onDelete: Restrict)
  accessLogs DocumentAccessLog[]

  @@index([projectId])
  @@index([dealRoomId])
  @@index([folderId])
  @@index([uploaderId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  link      String?
  read      Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, read])
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  resource   String?
  resourceId String?
  details    String?  @db.Text
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedBy   String?
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  email     String?
  action    String
  tableName String?
  recordId  String?
  oldValues String?  @db.Text
  newValues String?  @db.Text
  ipAddress String?
  createdAt DateTime @default(now())
}

// ─── Standalone entity models ──────────────────────────────────────────────────

model Investor {
  id               String   @id @default(cuid())
  name             String
  email            String?  @unique
  phone            String?
  type             String?  // PE_FUND | DFI | SOVEREIGN_WEALTH | FAMILY_OFFICE | PENSION_FUND | INFRASTRUCTURE_FUND | BANK | EPC | SPONSOR | GOVERNMENT | OTHER
  status           String   @default("ACTIVE")
  // Rich profile fields
  organizationType String?  // EPC | SPONSOR | INVESTOR | GOVERNMENT | DFI
  countryOfOrigin  String?
  sectorFocus      String?  // JSON array of sectors
  countryFocus     String?  // JSON array of countries
  stageFocus       String?  // JSON array of stages
  minTicket        Float?
  maxTicket        Float?
  aum              Float?
  targetIRR        Float?
  instruments      String?  // JSON array: Equity | Debt | Grant | Mezzanine
  languages        String?  // JSON array
  esgConstraints   String?
  website          String?
  description      String?  @db.Text
  profileComplete  Float    @default(0) // 0-100 completeness score
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  matches PartnerMatch[]

  @@index([status])
  @@index([organizationType])
}

model PartnerMatch {
  id         String   @id @default(cuid())
  investorId String
  projectId  String
  action     String   // INTERESTED | PASS | MEETING_REQUESTED
  matchScore Float    @default(0)
  note       String?
  createdBy  String
  createdAt  DateTime @default(now())

  investor Investor @relation(fields: [investorId], references: [id], onDelete: Cascade)

  @@unique([investorId, projectId])
  @@index([investorId])
  @@index([projectId])
}

model ExpressionOfInterest {
  id           String    @id @default(cuid())
  dealRoomId   String
  userId       String?
  name         String
  email        String
  organization String?
  message      String?   @db.Text
  status       String    @default("PENDING")  // PENDING | REVIEWED | ACCEPTED | DECLINED
  reviewedBy   String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  dealRoom DealRoom @relation(fields: [dealRoomId], references: [id], onDelete: Cascade)

  @@index([dealRoomId])
  @@index([status])
}

model SavedDeal {
  id         String   @id @default(cuid())
  userId     String
  dealRoomId String
  createdAt  DateTime @default(now())

  @@unique([userId, dealRoomId])
  @@index([userId])
}

model IcCommittee {
  id              String    @id @default(cuid())
  name            String
  description     String?
  status          String    @default("SCHEDULED")
  meetingDate     DateTime?
  projectId       String?
  quorumRequired  Int       @default(3)
  outcome         String?
  outcomeNotes    String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  votes   IcVote[]

  @@index([status])
  @@index([projectId])
}

model IcVote {
  id          String      @id @default(cuid())
  committeeId String
  userId      String
  vote        String      // approve | reject | abstain | defer
  rationale   String?     @db.Text
  createdAt   DateTime    @default(now())

  committee IcCommittee @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([committeeId, userId])
  @@index([committeeId])
}

model AccessRequest {
  id            String    @id @default(cuid())
  email         String    @unique
  fullName      String
  organization  String?
  country       String?
  phone         String?
  roleRequested String
  ministry      String?
  message       String?   @db.Text
  status        String    @default("PENDING")  // PENDING | APPROVED | REJECTED
  reviewedBy    String?
  reviewedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
}

model Verification {
  id                  String   @id @default(cuid())
  projectId           String
  level               String   @default("V0")
  status              String   @default("PENDING")
  technicalReadiness  Float    @default(0)
  financialRobustness Float    @default(0)
  legalClarity        Float    @default(0)
  esgCompliance       Float    @default(0)
  overallScore        Float    @default(0)
  notes               String?  @db.Text
  verifiedBy          String?
  verifiedAt          DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model AnalyticReport {
  id        String   @id @default(cuid())
  title     String
  type      String
  sector    String?
  country   String?
  content   String?  @db.Text
  data      String?  @db.Text
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdBy])
  @@index([type])
}

model Event {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  eventDate   DateTime
  location    String?
  type        String   @default("general")
  projectId   String?
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  creator User     @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([eventDate])
}

// ─── Messenger models ─────────────────────────────────────────────────────────

model Channel {
  id          String   @id @default(cuid())
  type        String   // PROJECT | DIRECT | GROUP | PARTNER_INTERNAL
  name        String?
  description String?
  projectId   String?
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members  ChannelMember[]
  messages Message[]

  @@index([projectId])
  @@index([type])
}

model ChannelMember {
  id          String    @id @default(cuid())
  channelId   String
  userId      String
  role        String    @default("MEMBER")  // MEMBER | ADMIN
  lastReadAt  DateTime?
  joinedAt    DateTime  @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([channelId])
  @@index([userId])
}

model Message {
  id          String    @id @default(cuid())
  channelId   String
  senderId    String
  content     String    @db.Text
  threadId    String?   // parent message id for threads
  attachmentUrl String?
  attachmentName String?
  editedAt    DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId])
  @@index([senderId])
  @@index([threadId])
  @@index([createdAt])
}
